{
  "name": "mimlet-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:prepare": "node scripts/prepare.ts",
    "docs:dev": "node scripts/dev.ts",
    "docs:build": "pnpm docs:prepare && vitepress build .",
    "docs:preview": "node scripts/preview.ts",
    "type-check": "pnpm docs:prepare && vue-tsc --noEmit",
    "test": "playwright test",
    "test:install": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.1",
    "typescript": "6.0.3",
    "vitepress": "1.6.4",
    "vue": "3.5.43",
    "vue-tsc": "3.3.11"
  }
}
