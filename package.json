{
  "name": "hey-api-builders",
  "version": "2.0.0",
  "description": "Immutable, type-safe test data builders powered by Hey API's generated Faker factories.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "watch": "tsup --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "test": "vitest run",
    "test:package": "node scripts/validate-package.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage",
    "validate": "pnpm check && pnpm build && pnpm test:package",
    "pack:check": "npm pack --dry-run",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm check"
  },
  "keywords": [
    "hey-api",
    "openapi",
    "openapi-ts",
    "plugin",
    "faker",
    "builder",
    "test-data",
    "mock"
  ],
  "author": "JeffreyNijs",
  "license": "MIT",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "esbuild": "0.28.1",
      "flatted": "3.4.4",
      "js-yaml": "4.3.1",
      "nanoid@3": "3.3.18",
      "picomatch": "4.0.5",
      "postcss": "8.5.26",
      "rollup": "4.62.4",
      "vite@7": "7.3.5"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JeffreyNijs/hey-api-builders.git"
  },
  "homepage": "https://github.com/JeffreyNijs/hey-api-builders#readme",
  "bugs": {
    "url": "https://github.com/JeffreyNijs/hey-api-builders/issues"
  },
  "peerDependencies": {
    "@faker-js/faker": "^10.0.0",
    "@hey-api/openapi-ts": "^0.99.0",
    "typescript": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@faker-js/faker": "10.6.0",
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "26.4.1",
    "@typescript-eslint/eslint-plugin": "8.69.0",
    "@typescript-eslint/parser": "8.69.0",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "prettier": "3.9.6",
    "tsup": "8.5.1",
    "typescript": "7.0.2",
    "vitest": "5.0.0",
    "zod": "4.5.4"
  }
}
