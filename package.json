{
  "name": "test-builders-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Modular schema-independent test-data toolkit and integrations.",
  "type": "module",
  "license": "MIT",
  "author": "JeffreyNijs",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.18.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "esbuild": "0.28.1",
      "flatted": "3.4.4",
      "nanoid@3": "3.3.18",
      "picomatch": "4.0.5",
      "postcss": "8.5.26",
      "rollup": "4.62.4",
      "vite@7": "7.3.5",
      "js-yaml@4": "4.3.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@faker-js/faker": "10.5.0",
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "22.20.1",
    "@typescript-eslint/eslint-plugin": "8.66.0",
    "@typescript-eslint/parser": "8.66.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "prettier": "3.9.6",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "zod": "4.4.3",
    "@changesets/cli": "3.0.3",
    "@arethetypeswrong/cli": "0.18.5",
    "publint": "0.3.24",
    "@jeffreynijs/test-builders": "workspace:*",
    "hey-api-builders": "workspace:*"
  },
  "scripts": {
    "preinstall": "node scripts/check-workspace.mjs",
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "build:core": "tsc -p packages/test-builders/tsconfig.json",
    "watch": "pnpm --filter hey-api-builders watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "typecheck": "pnpm -r --workspace-concurrency=1 run typecheck && tsc --noEmit",
    "test": "pnpm test:core && vitest run && pnpm test:typebox && pnpm test:optional",
    "test:core": "tsc -p packages/test-builders/tsconfig.json && tsc -p packages/test-builders/test/tsconfig.json && node scripts/test-core.mjs",
    "test:watch": "vitest",
    "test:coverage": "pnpm test:core && vitest run --coverage && pnpm test:typebox && pnpm test:optional",
    "test:typebox": "node scripts/test-typebox.mjs",
    "test:optional": "node scripts/test-optional-all.mjs",
    "test:tooling": "node --test tests/tooling/*.test.mjs",
    "test:package": "node scripts/validate-package.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "check:workspace": "node scripts/check-workspace.mjs",
    "check": "pnpm check:workspace && pnpm build && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:tooling && pnpm test:coverage",
    "validate": "pnpm check && pnpm test:package",
    "pack:check": "node scripts/pack-workspace.mjs --check",
    "release:prepare": "node scripts/pack-workspace.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "test:runtimes": "node scripts/test-runtimes.mjs",
    "test:examples": "node scripts/test-examples.mjs",
    "benchmark": "node scripts/benchmark.mjs"
  }
}
