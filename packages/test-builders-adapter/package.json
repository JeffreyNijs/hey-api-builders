{
  "name": "@jeffreynijs/test-builders-adapter",
  "version": "0.1.0-alpha.0",
  "private": false,
  "description": "Capability-aware adapter SDK, inspection and reusable conformance checks for test builders.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JeffreyNijs/hey-api-builders.git",
    "directory": "packages/test-builders-adapter"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "pnpm type-check",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "test:unit": "vitest run --root ../.. --project unit tests/unit/test-builders-adapter.test.ts"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next"
  },
  "bugs": {
    "url": "https://github.com/JeffreyNijs/hey-api-builders/issues"
  },
  "homepage": "https://github.com/JeffreyNijs/hey-api-builders/tree/main/packages/test-builders-adapter#readme",
  "keywords": [
    "test-data",
    "fixtures",
    "builders",
    "standard-schema"
  ],
  "dependencies": {
    "@jeffreynijs/test-builders": "0.1.0-alpha.0"
  }
}
