{
  "name": "@jeffreynijs/test-builders-codegen",
  "version": "0.0.0",
  "private": true,
  "description": "Deterministic schema-independent builder classes, owned output and CLI.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@jeffreynijs/test-builders": "0.0.0",
    "@jeffreynijs/test-builders-json-schema": "0.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JeffreyNijs/hey-api-builders.git",
    "directory": "packages/test-builders-codegen"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "json-schema-to-typescript": "16.0.0"
  },
  "bin": {
    "test-builders": "./dist/cli.js"
  }
}
