{
  "name": "@jeffreynijs/test-builders-faker",
  "version": "0.1.0-alpha.0",
  "private": false,
  "description": "Locale-aware realistic fixtures with session-owned randomness and reference time.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@faker-js/faker": "10.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JeffreyNijs/hey-api-builders.git",
    "directory": "packages/test-builders-faker"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "pnpm type-check",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "test:unit": "vitest run --root ../.. --project unit tests/unit/test-builders-faker.test.ts"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next"
  },
  "bugs": {
    "url": "https://github.com/JeffreyNijs/hey-api-builders/issues"
  },
  "homepage": "https://github.com/JeffreyNijs/hey-api-builders/tree/main/packages/test-builders-faker#readme",
  "keywords": [
    "test-data",
    "fixtures",
    "builders",
    "standard-schema"
  ],
  "devDependencies": {
    "@faker-js/faker": "10.5.0"
  },
  "dependencies": {
    "@jeffreynijs/test-builders": "0.1.0-alpha.0"
  }
}
