    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@jeffreynijs/test-builders": "0.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JeffreyNijs/hey-api-builders.git",
    "directory": "packages/test-builders-json-schema"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "json-schema-faker": "0.6.3"
  }
