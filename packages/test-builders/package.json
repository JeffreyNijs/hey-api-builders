{
  "name": "@jeffreynijs/test-builders",
  "version": "0.1.0-alpha.0",
  "private": false,
  "description": "Schema-independent immutable test-data builders with Standard Schema validation.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JeffreyNijs/hey-api-builders.git",
    "directory": "packages/test-builders"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && tsc -p test/tsconfig.json && node --test test/*.test.mjs",
    "prepack": "npm run build",
    "typecheck": "pnpm type-check",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "test:unit": "vitest run --root ../.. --project unit tests/unit/test-builders.test.ts"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next"
  },
  "bugs": {
    "url": "https://github.com/JeffreyNijs/hey-api-builders/issues"
  },
  "homepage": "https://github.com/JeffreyNijs/hey-api-builders/tree/main/packages/test-builders#readme",
  "keywords": [
    "test-data",
    "fixtures",
    "builders",
    "standard-schema"
  ]
}
