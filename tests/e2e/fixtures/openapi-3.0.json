{
  "openapi": "3.0.3",
  "info": {
    "title": "OpenAPI 3.0 builders fixture",
    "version": "1.0.0"
  },
  "paths": {
    "/profiles": {
      "post": {
        "operationId": "createProfile",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Profile"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Role": {
        "type": "string",
        "enum": ["reader", "author", "admin"]
      },
      "Profile": {
        "type": "object",
        "required": ["email", "role", "settings"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "display_name": {
            "type": "string",
            "nullable": true
          },
          "settings": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            }
          },
          "locale": {
            "type": "string",
            "default": "en-BE"
          }
        }
      }
    }
  }
}
